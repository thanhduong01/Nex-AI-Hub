# Supabase Project Settings → API. Keep real values in .env.local (ignored).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Generate once: openssl rand -base64 32. Back up securely; changing loses access to encrypted AI keys.
CREDENTIAL_ENCRYPTION_KEY=
# Exact origin, no trailing path. Use production URL on Vercel, localhost locally.
APP_URL=http://localhost:3000
# Only for scripts/bootstrap-owner.ts, remove after bootstrap. Never add OWNER_PASSWORD to Vercel.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
WORKSPACE_NAME=NexMO Workspace
